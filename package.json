{
  "name": "pingpong-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:v2 && npm run test:migration && npm run test:legacy-locks && npm run test:legacy-submissions && npm run test:admin-safety && npm run test:lifecycle-safety && npm run test:release-safety",
    "test:v2": "tsc -p tsconfig.v2-tests.json && node --test --test-concurrency=1 ./.v2-test-build/lib/server/certificate-records.test.js ./.v2-test-build/lib/server/match/doubles-source.test.js ./.v2-test-build/lib/server/match/doubles-source.integration.test.js ./.v2-test-build/lib/server/match/engine-guard.test.js ./.v2-test-build/lib/server/match/remove-participant.test.js ./.v2-test-build/lib/server/match/quick-result-state.test.js ./.v2-test-build/lib/server/match/rewards.test.js ./.v2-test-build/lib/server/match/team-source.test.js ./.v2-test-build/lib/server/user/ban-user.test.js ./.v2-test-build/lib/server/user/hard-delete-users.test.js ./.v2-test-build/lib/server/user/lock-users.test.js ./.v2-test-build/modules/competitions-v2/domain/domain.test.js ./.v2-test-build/modules/competitions-v2/application/*.test.js",
    "test:migration": "node --test scripts/migration/add-v2-core.test.mjs scripts/migration/add-v2-creation-idempotency.test.mjs scripts/migration/add-v2-grouping-foundation.test.mjs scripts/migration/strengthen-v2-source-match-fks.test.mjs scripts/migration/add-v2-qualification-fixture-sources.test.mjs scripts/migration/add-v2-knockout-admin-resolution.test.mjs",
    "test:legacy-locks": "node --test scripts/legacy-settlement-locks.test.mjs",
    "test:legacy-submissions": "node --test scripts/legacy-result-submission-locks.test.mjs",
    "test:admin-safety": "node --test scripts/admin-user-hard-delete.test.mjs",
    "test:lifecycle-safety": "node --test scripts/lifecycle-safety-membrane.test.mjs",
    "test:release-safety": "node --test scripts/v2-cutover-preflight.test.mjs",
    "test:local-db-safety": "node --test scripts/local-postgres-safety.test.mjs",
    "seed:v2:acceptance": "tsc -p tsconfig.v2-tests.json && node scripts/seed-v2-acceptance.mjs",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "db:local:status": "bash scripts/local-postgres.sh status",
    "db:local:migrate": "bash scripts/local-postgres.sh migrate",
    "db:local:verify": "bash scripts/local-postgres.sh verify",
    "db:local:rebuild": "bash scripts/local-postgres.sh rebuild",
    "dev:local": "bash scripts/local-postgres.sh dev",
    "test:v2:local": "bash scripts/local-postgres.sh test-v2",
    "preflight:v2-cutover": "node scripts/v2-cutover-preflight.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@azure/communication-email": "^1.0.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-popover": "^1.1.15",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-cloudinary": "^6.17.5",
    "pdfkit": "^0.17.1",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/pdfkit": "^0.13.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Edge versions",
      "last 2 Safari versions",
      "last 2 iOS versions",
      ">0.5%",
      "not dead"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Edge version",
      "last 1 Safari version"
    ]
  }
}
