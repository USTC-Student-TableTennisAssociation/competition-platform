model MatchResult {
  id                String    @id @default(cuid())
  matchId           String
  winnerId          String?
  loserId           String?
  winnerMatchTeamId String?   @map("winner_match_team_id")
  loserMatchTeamId  String?   @map("loser_match_team_id")
  winnerTeamIds     String[]  @default([])
  loserTeamIds      String[]  @default([])
  score             Json
  reportedBy        String
  confirmed         Boolean   @default(false)
  resultVerifiedAt  DateTime?
  verifierId        String?
  createdAt         DateTime  @default(now())

  match           Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winner          User?        @relation("ResultWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  loser           User?        @relation("ResultLoser", fields: [loserId], references: [id], onDelete: SetNull)
  reporter        User         @relation("ResultReporter", fields: [reportedBy], references: [id], onDelete: Cascade)
  verifier        User?        @relation("ResultVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  winnerMatchTeam MatchTeam?   @relation("MatchResultWinnerTeam", fields: [winnerMatchTeamId], references: [id], onDelete: SetNull)
  loserMatchTeam  MatchTeam?   @relation("MatchResultLoserTeam", fields: [loserMatchTeamId], references: [id], onDelete: SetNull)
  eloHistory      EloHistory[]

  @@index([winnerId])
  @@index([loserId])
  @@index([winnerMatchTeamId])
  @@index([loserMatchTeamId])
  @@index([matchId, createdAt])
}

