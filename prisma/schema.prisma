  matchId      String                 @map("match_id")
  captainId    String                 @map("captain_id")
  name         String
  inviteCode   String                 @unique @map("invite_code")
  contact      String?
  remark       String?
  reviewNote   String?                @map("review_note")
  status       TeamRegistrationStatus @default(draft)
  submittedAt  DateTime?              @map("submitted_at")
  reviewedAt   DateTime?              @map("reviewed_at")
  reviewedById String?                @map("reviewed_by_id")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  match               Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  captain             User              @relation("MatchTeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)
  reviewedBy          User?             @relation("MatchTeamReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
