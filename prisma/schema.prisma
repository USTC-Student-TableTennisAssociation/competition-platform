model MatchGrouping {
  id                     String                   @id @default(cuid())
  matchId                String                   @unique
  payload                Json
  v2SchemaVersion        Int?                     @map("v2_schema_version")
  seedMethod             MatchGroupingSeedMethod? @map("seed_method")
  standingsPolicyVersion Int?                     @map("standings_policy_version")
  qualifiersPerGroup     Int?                     @map("qualifiers_per_group")
  bracketPolicyVersion   Int?                     @map("bracket_policy_version")
  createdAt              DateTime                 @default(now())

  match                 Match                       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  groups                MatchGroup[]
  qualificationSnapshot MatchQualificationSnapshot?

  @@unique([id, matchId], map: "match_grouping_id_match_id_key")
}

/// One relational group in a V2 grouping publication. `matchId` is repeated so
/// every child edge can prove that it belongs to the same competition.
model MatchGroup {
  id          String   @id @default(cuid())
  matchId     String   @map("match_id")
  groupingId  String   @map("grouping_id")
  groupKey    String   @map("group_key")
  displayName String   @map("display_name")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  match                  Match                        @relation(fields: [matchId], references: [id], onDelete: Restrict, map: "match_group_match_id_fkey")
  grouping               MatchGrouping                @relation(fields: [groupingId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_group_grouping_match_fkey")
  entries                MatchGroupEntry[]
  fixtures               MatchFixture[]
  qualificationStandings MatchQualificationStanding[]

  @@unique([id, matchId], map: "match_group_id_match_id_key")
  @@unique([groupingId, groupKey], map: "match_group_grouping_key_key")
  @@unique([groupingId, position], map: "match_group_grouping_position_key")
  @@index([matchId], map: "match_group_match_id_idx")
  @@map("match_group")
}

/// Frozen publication-time seeding inputs. These values make the grouping and
/// later knockout placement reproducible even after Entry/user data changes.
model MatchGroupEntry {
  id             String   @id @default(cuid())
  matchId        String   @map("match_id")
  groupId        String   @map("group_id")
  entryId        String   @map("entry_id")
  position       Int
  globalSeedRank Int      @map("global_seed_rank")
  seedElo        Int      @map("seed_elo")
  seedPoints     Int      @map("seed_points")
  entryVersion   Int      @map("entry_version")
  rosterVersion  Int      @map("roster_version")
  createdAt      DateTime @default(now()) @map("created_at")

  match                  Match                        @relation(fields: [matchId], references: [id], onDelete: Restrict, map: "match_group_entry_match_id_fkey")
  group                  MatchGroup                   @relation(fields: [groupId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_group_entry_group_match_fkey")
  entry                  MatchEntry                   @relation(fields: [entryId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_group_entry_entry_match_fkey")
  qualificationStandings MatchQualificationStanding[]

  @@unique([id, matchId], map: "match_group_entry_id_match_id_key")
  @@unique([groupId, entryId], map: "match_group_entry_group_entry_key")
  @@unique([groupId, entryId, matchId], map: "match_group_entry_membership_identity_key")
  @@unique([groupId, position], map: "match_group_entry_group_position_key")
  @@unique([matchId, entryId], map: "match_group_entry_match_entry_key")
  @@unique([matchId, globalSeedRank], map: "match_group_entry_match_seed_rank_key")
  @@index([entryId], map: "match_group_entry_entry_id_idx")
  @@map("match_group_entry")
}

/// Immutable qualification decision for one grouping publication. The source
/// fingerprint binds it to the complete authoritative ResultRevision set.
model MatchQualificationSnapshot {
  id                        String   @id @default(cuid())
  matchId                   String   @map("match_id")
  groupingId                String   @unique(map: "match_qualification_snapshot_grouping_id_key") @map("grouping_id")
  schemaVersion             Int      @map("schema_version")
  standingsPolicyVersion    Int      @map("standings_policy_version")
  sourceRevisionFingerprint String   @map("source_revision_fingerprint")
  createdAt                 DateTime @default(now()) @map("created_at")

  match     Match                        @relation(fields: [matchId], references: [id], onDelete: Restrict, map: "match_qualification_snapshot_match_id_fkey")
  grouping  MatchGrouping                @relation(fields: [groupingId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_qualification_snapshot_grouping_match_fkey")
  standings MatchQualificationStanding[]

  @@unique([id, matchId], map: "match_qualification_snapshot_id_match_id_key")
  @@unique([groupingId, matchId], map: "match_qualification_snapshot_grouping_match_key")
  @@index([matchId], map: "match_qualification_snapshot_match_id_idx")
  @@map("match_qualification_snapshot")
}

/// A frozen group ranking row. The membership composite relation prevents a
/// standing from pairing a group with an Entry that was published elsewhere.
model MatchQualificationStanding {
  id                  String   @id @default(cuid())
  matchId             String   @map("match_id")
  snapshotId          String   @map("snapshot_id")
  groupId             String   @map("group_id")
  entryId             String   @map("entry_id")
  rank                Int
  played              Int
  wins                Int
  losses              Int
  scoreFor            Int      @map("score_for")
  scoreAgainst        Int      @map("score_against")
  scoreDifferential   Int      @map("score_differential")
  qualified           Boolean
  qualificationOrder  Int?     @map("qualification_order")
  ineligibilityReason String?  @map("ineligibility_reason")
  createdAt           DateTime @default(now()) @map("created_at")

  match               Match                      @relation(fields: [matchId], references: [id], onDelete: Restrict, map: "match_qualification_standing_match_id_fkey")
  snapshot            MatchQualificationSnapshot @relation(fields: [snapshotId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_qualification_standing_snapshot_match_fkey")
  group               MatchGroup                 @relation(fields: [groupId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_qualification_standing_group_match_fkey")
  entry               MatchEntry                 @relation(fields: [entryId, matchId], references: [id, matchId], onDelete: Restrict, map: "match_qualification_standing_entry_match_fkey")
  groupEntry          MatchGroupEntry            @relation(fields: [groupId, entryId, matchId], references: [groupId, entryId, matchId], onDelete: Restrict, map: "match_qualification_standing_membership_fkey")
  fixtureDependencies MatchFixtureDependency[]   @relation("MatchFixtureDependencyQualificationSource")

  @@unique([id, matchId], map: "match_qualification_standing_id_match_id_key")
  @@unique([snapshotId, groupId, entryId], map: "match_qualification_standing_snapshot_membership_key")
  @@unique([snapshotId, entryId], map: "match_qualification_standing_snapshot_entry_key")
  @@unique([snapshotId, groupId, rank], map: "match_qualification_standing_snapshot_group_rank_key")
  @@unique([snapshotId, qualificationOrder], map: "match_qualification_standing_snapshot_order_key")
  @@index([matchId], map: "match_qualification_standing_match_id_idx")
  @@index([groupId, entryId, matchId], map: "match_qualification_standing_membership_idx")
  @@index([entryId], map: "match_qualification_standing_entry_id_idx")
  @@map("match_qualification_standing")
}

model RankingSnapshot {
  id        String   @id @default(cuid())
  scope     String
